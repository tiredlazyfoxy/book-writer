# BookWriter — environment template for the deployed container.
#
# READ THIS FIRST. LLM provider and LLM-server settings — base_url, model
# names, which server is default — are NOT configured here. They live IN THE
# DATABASE and are edited through the Admin SPA. A stored api_key is never a
# raw secret: it is a pointer of the form "$SOME_ENV_VAR" that the backend
# resolves from this process's environment at call time
# (app/services/secrets.py:resolve_env_ref).
#
# So this file has exactly one job: supply the *values* those $ENV_VAR pointers
# resolve against, plus a few backend settings. If you are looking for a
# base_url, it is not here — open the Admin SPA.
#
# There is also no JWT secret to set: signing keys are per user and stored in
# the database.
#
# Usage: copy to .env next to docker-compose.yml and fill in what you need.
# update.sh creates .env from this template automatically when it is missing,
# and warns that it needs filling in.

# ---------------------------------------------------------------------------
# Values referenced by $ENV_VAR api_key pointers configured in the Admin SPA
# ---------------------------------------------------------------------------

# Referenced as api_key = "$OPENAI_API_KEY" on an OpenAI-compatible server.
OPENAI_API_KEY=

# Base URL of a local llama-swap / OpenAI-compatible server, when the server
# entry in the Admin SPA references it as "$LLAMA_SWAP_URL".
LLAMA_SWAP_URL=

# ---------------------------------------------------------------------------
# Backend settings
# ---------------------------------------------------------------------------

# Google Programmable Search credentials, used by the assistant's web search.
# Leave blank to disable web search. Two values from two different consoles:
# the API key comes from the Google Cloud console with the "Custom Search API"
# enabled; the engine id ("cx") comes from programmablesearchengine.google.com,
# where the engine must have "Search the entire web" turned ON — without it the
# API answers 200 with no results and the tool reports "no results" forever.
#
# RAW values here, not "$ENV_VAR" pointers: this file is read inside the
# container, where the host's environment variables do not exist. (For host-side
# development, backend/.env.local may point at SEARCH_CSE_KEY / SEARCH_CSE_ID
# instead, and docker-compose.dev.yml falls back to those same two names.)
BOOKWRITER_GOOGLE_SEARCH_API_KEY=
BOOKWRITER_GOOGLE_SEARCH_ENGINE_ID=

# Snowflake id generator node number. Must be unique per running instance if
# you ever run more than one against the same data. Defaults to 0.
BOOKWRITER_NODE_ID=0
